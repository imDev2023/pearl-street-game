{
  "name": "@pearlstreet/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared chain constants, addresses, and the Chainlink feed registry for Pearl Street.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
